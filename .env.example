# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser commitado no Git (já está no .gitignore).

# Chave secreta usada pelo Flask para assinar sessões e cookies.
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta

# Bot do Telegram usado para enviar alertas de intrusao.
# Crie um bot com o @BotFather e pegue o chat_id com @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Porta local usada pelo servidor Flask embutido no app desktop.
SIEM_PORT=5001

# Janela de tempo (minutos) para verificar novos eventos de logon
# falhado (Event ID 4625) no Log de Segurança do Windows.
SIEM_SCAN_WINDOW_MINUTES=5

# Intervalo (segundos) entre cada varredura do log de eventos.
SIEM_SCAN_INTERVAL_SECONDS=10
